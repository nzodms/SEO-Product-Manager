# =========================================================================
# SEO Product Manager — Environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# =========================================================================

# ---- AI providers -------------------------------------------------------
# Google Gemini (default provider). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternative providers (leave blank if unused).
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model used when an agent does not specify its own.
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash

# ---- Database -----------------------------------------------------------
# SQLite for local dev. Swap for a Postgres URL in production, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/seo_product_manager"
DATABASE_URL="file:./dev.db"

# ---- Shopify (per shop) -------------------------------------------------
# Each managed shop needs a custom-app Admin API access token.
# These can also be stored encrypted in the DB via the Settings UI.
# Format below is the bootstrap fallback for a single shop.
SHOPIFY_DEFAULT_SHOP_DOMAIN=
SHOPIFY_DEFAULT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# ---- App ----------------------------------------------------------------
# Random string used to encrypt stored Shopify tokens & client secrets at rest.
APP_ENCRYPTION_KEY=
# Public origin of this app, used to build the Shopify OAuth redirect URI.
# Leave blank for local dev (auto-detected as http://localhost:3000).
# In production set e.g. APP_URL=https://seo.tondomaine.com
APP_URL=

# Secret protecting the scheduled job processor /api/jobs/tick. On Vercel, set
# this env var and Vercel Cron will automatically send it as a Bearer token.
# Generate with: openssl rand -hex 32
CRON_SECRET=

NODE_ENV=development
