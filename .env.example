# =========================================================================
# SEO Product Manager — Environment variables
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# =========================================================================

# ---- AI providers -------------------------------------------------------
# Google Gemini (default provider). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional alternative providers (leave blank if unused).
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default model used when an agent does not specify its own.
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-2.5-flash

# ---- Database -----------------------------------------------------------
# SQLite for local dev. Swap for a Postgres URL in production, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/seo_product_manager"
DATABASE_URL="file:./dev.db"

# ---- Shopify (per shop) -------------------------------------------------
# Each managed shop needs a custom-app Admin API access token.
# These can also be stored encrypted in the DB via the Settings UI.
# Format below is the bootstrap fallback for a single shop.
SHOPIFY_DEFAULT_SHOP_DOMAIN=
SHOPIFY_DEFAULT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01

# ---- App ----------------------------------------------------------------
# Random string used to encrypt stored Shopify tokens at rest.
APP_ENCRYPTION_KEY=
NODE_ENV=development
